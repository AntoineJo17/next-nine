  "old":"[...a.teammates,...a.defenders].forEach((p,i)=>{const side=i%2?1:-1,rank=Math.floor(i/2)%5;",
  "new":"[...a.teammates.filter(t=>t.tacticalId%11!==0),...a.defenders].forEach((p,i)=>{const side=i%2?1:-1,rank=Math.floor(i/2)%5;"},
