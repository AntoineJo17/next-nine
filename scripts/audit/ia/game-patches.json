 {"id":"G1","file":"dist/game.js","why":"Phase pressing : les 20 autres joueurs sont figés (updateActors rend la main immédiatement ; patrol() n'est jamais appelée).",
  "old":"function updateActors(a,dt){if(a.phase==='press')return;",
  "new":"function updateActors(a,dt){if(a.phase==='press'){let k=0;for(const p of [...a.defenders,...(a.teammates||[])]){if(p===a.pressCarrier||p.tacticalId%11===0)continue;if(!p.home)p.home={x:p.x,z:p.z};patrol(p,k++,dt);}return;}"},
